{
  // ============================================================
  // Independent Cloudflare Production Worker configuration.
  // Infrastructure prepared 2026-10-09 (see docs/PRODUCTION-
  // INFRASTRUCTURE-SETUP.md) -- NOT YET DEPLOYED.
  // ============================================================
  //
  // Populated from wrangler.production.example.jsonc's template -- see
  // that file's own header for why a separate, wrangler-managed
  // production Worker is a NEW thing, distinct from the legacy ChatGPT
  // Sites production platform.
  //
  // TEAM_DOMAIN and POLICY_AUD below are the REAL values -- the owner
  // created the Production Cloudflare Access Application (Zero Trust
  // dashboard; this session's Cloudflare credentials have no API scope
  // for that step, so it was necessarily manual) on 2026-10-09 and
  // supplied them directly. Per this round's own security pre-flight
  // requirement, a Production environment missing either value must
  // never be considered secure or ready; lib/auth/provider-selection.ts's
  // hardening (commit f1137eb) only excludes the legacy, unverified
  // ChatGPT Sites header when BOTH are genuinely present -- now true
  // here. This file is still NOT deployed (no `wrangler deploy` has been
  // run against it) -- see docs/PRODUCTION-INFRASTRUCTURE-SETUP.md for
  // exactly what remains before that.
  //
  // Build with `pnpm run build:production-independent` (scripts/
  // build-production-independent.mjs) before deploying this config --
  // NEVER `pnpm run build:production` (scripts/build-production.mjs),
  // which remains legacy-ChatGPT-Sites-only and sets
  // FUNDRAISING_OS_ENVIRONMENT to the SAME "production" value legacy
  // production itself uses. Using the wrong one here would make
  // lib/operations/staging-reset.ts's own environment check the only
  // thing standing between this Worker and that endpoint (it would still
  // correctly return 404, since deploymentEnvironment would resolve to
  // "production", never "staging-independent" -- but there is no reason
  // to rely on that instead of simply using the correct, dedicated build
  // script every time).
  "name": "fundraising-os-production",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // Cloudflare Images (IMAGES binding) is optional — see wrangler.staging.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundraising-os-production-db",
      // Created 2026-10-09 via `wrangler d1 create fundraising-os-production-db`,
      // isolated from fundraising-os-staging-db (6c18396c-0a8f-4f2c-ba83-
      // ea809ec10289). Migrated 2026-10-12 (docs/PRODUCTION-DONOR-DATA-
      // CUTOVER-EXECUTION.md) -- this is now the authoritative, live
      // donor/fundraising dataset, not an empty database.
      "database_id": "a51c6571-ae16-4614-aa9a-08f8e6be3ecd"
    }
  ],
  // Cloudflare Workers AI binding -- AI Meeting Notes "Organize Notes"
  // (docs/AI-HANDOFF.md, "Authorized Production Deployment of AI
  // Meeting Notes"), owner-authorized 2026-10-16 after extensive
  // Staging verification. Identical binding to wrangler.staging.jsonc's
  // own -- NOT a secret, declared directly here like DB above, on the
  // same Cloudflare account already used for Staging's own verified
  // Workers AI usage (confirmed same account id for both Workers).
  "ai": {
    "binding": "AI"
  },
  // Worker-to-Worker binding only -- NOT an R2 binding, mirroring
  // wrangler.staging.jsonc's own comment and guardrail exactly. Points at
  // the (not yet deployed) Production status-worker -- see
  // status-worker/wrangler.production.jsonc. Deploying THIS Worker before
  // that one exists will leave this binding unresolved; deploy the
  // status-worker first.
  "services": [
    {
      "binding": "STATUS_WORKER",
      "service": "fundraising-os-production-backup-status"
    }
  ],
  "vars": {
    // Real values from the Production Cloudflare Access Application the
    // owner created 2026-10-09 -- see this file's own header comment.
    // Same Zero Trust organization Staging uses; a separate Application
    // and AUD within it, restricted to the one authorized owner email
    // below (confirmed in the Access policy itself, not just here).
    "TEAM_DOMAIN": "fundraising-os.cloudflareaccess.com",
    "POLICY_AUD": "7cfff2279260cb67e19af8c129b2ba6cdd137ba855ddb638ff316493f8ef14e1",
    // The sole email allowed to authenticate -- set to the real,
    // explicitly authorized owner per this round's own instruction. This
    // value is independent of Access setup (it's this app's own
    // defense-in-depth re-check of the JWT's email claim, not the Access
    // policy's own allow-list, which is configured separately in the
    // Access policy itself).
    "STAGING_OWNER_EMAIL": "sgoldstein@nirc.edu",
    // The real custom domain, corrected 2026-10-14 (docs/AI-HANDOFF.md's
    // "October 14 Email Incident" entry) from the previously-set
    // workers.dev placeholder value
    // ("https://fundraising-os-production.sgoldstein.workers.dev"), which
    // every Daily Fundraising Agenda email link was built from until this
    // fix. shimmydonors.org already routes to this Worker (confirmed via
    // a live, read-only check 2026-10-14), so this is a pure identity
    // correction -- not yet deployed; see that same AI-HANDOFF.md entry
    // for the separate, Cloudflare-zone-level redirect-rule correction
    // still required outside this repository before a clicked link stops
    // bouncing through the workers.dev hostname.
    "APP_BASE_URL": "https://shimmydonors.org",
    // Morning-brief Service Token auth (lib/auth/cloudflare-access.ts),
    // Production Automation and Backup Transition round, 2026-10-12. The
    // SAME Client ID already used on Staging (wrangler.staging.jsonc) --
    // reused, never a new/rotated token, per this round's own
    // authorization. A Client ID alone grants no access (the Client
    // Secret, which this Worker never sees, does) -- see
    // cloudflare-env.d.ts's own doc comment.
    //
    // NOT YET EFFECTIVE on its own: this only lets the app's OWN identity
    // check accept the token. Cloudflare Access itself must separately
    // be told, in the Zero Trust dashboard, that THIS token is allowed to
    // authenticate against Production's Access Application (a Service
    // Auth policy) -- that step has no API this session's Cloudflare
    // credentials can reach (confirmed: no Access/Zero-Trust scope; no
    // `wrangler access`/`zero-trust` subcommand exists either) and must
    // be done manually by the owner. Until then, a request bearing this
    // token is rejected at the Access edge exactly as it is today -- no
    // security restriction is weakened by setting this var early.
    "MORNING_BRIEF_SERVICE_TOKEN_CLIENT_ID": "983ea5fccaebc48932c5e69df510f74a.access",
    // AI Meeting Notes "Organize Notes" (docs/AI-HANDOFF.md, "Authorized
    // Production Deployment of AI Meeting Notes"). AI_PROVIDER picks
    // which provider app/api/meeting-notes/organize/route.ts calls --
    // "workers-ai" is the ONLY provider configured here. Anthropic is
    // deliberately NOT enabled: no ANTHROPIC_API_KEY secret exists on
    // Production (confirmed via `wrangler secret list` -- only the three
    // Gmail OAuth secrets are present), so selecting "anthropic" would
    // just report "AI organization isn't configured yet," never used.
    "AI_PROVIDER": "workers-ai",
    // The Workers AI model id, identical to wrangler.staging.jsonc's own
    // already-verified value. NOT a secret -- the `ai` binding above is
    // the only credential this provider needs.
    "WORKERS_AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct"
  },
  // Daily Fundraising Agenda email cron -- ACTIVE (2026-10-12 Production
  // Daily Email Cutover round, docs/AI-HANDOFF.md). The owner entered
  // the three Gmail secrets directly in the Cloudflare dashboard;
  // independently re-verified via `wrangler secret list --config
  // wrangler.production.jsonc` before this change (all three present).
  // This is now the sole live copy of this cron -- the matching
  // `"triggers"` block was removed from wrangler.staging.jsonc in the
  // same deploy step. runScheduledBackupAlertCheck (lib/backup-alert/
  // run.ts) shares this same scheduled() invocation (worker/index.ts),
  // so moving this cron also activates Production's backup-failure
  // alerting -- no separate change needed for that.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
