{
  // Dedicated, minimal status-reporting Worker for the D1 backup/restore
  // pipeline. Deliberately deployed and configured separately from the
  // main "fundraising-os-staging" Worker (worker/index.ts /
  // wrangler.staging.jsonc):
  //   - No `routes` and `workers_dev: false` -- this Worker has no public
  //     URL at all. It is reachable only via a Service Binding from
  //     another Worker; see wrangler.staging.jsonc's `services` entry.
  //   - Its only binding is read access to the status-metadata bucket
  //     below, never the separate bucket the nightly/monthly workflows
  //     write actual encrypted backup content to. R2 bucket bindings do
  //     not have a platform-enforced read-only mode -- the enforcement here is
  //     that this Worker's own source code (status-worker/src/index.ts)
  //     only ever calls `.get()`, never `.put()`/`.delete()`/`.list()` --
  //     see tests/status-worker.test.mjs, which fails if that ever
  //     changes.
  "name": "fundraising-os-backup-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "r2_buckets": [
    {
      "binding": "STATUS_BUCKET",
      "bucket_name": "fundraising-os-backup-status"
    }
  ],
  // Plain (non-secret) environment identity consumed by
  // resolveBackupWorkflowFile() (status-worker/src/github-dispatch.ts) to
  // select the one GitHub Actions backup workflow this Worker is allowed
  // to dispatch -- see docs/PRODUCTION-BACKUP-WATCHDOG-CORRECTION.md.
  // Correction (2026-10-11, backup watchdog deployment round): this
  // comment previously claimed the deployed Worker "already has no
  // GITHUB_BACKUP_DISPATCH_TOKEN secret." That was never true -- live
  // inspection (`wrangler secret list`) confirms this Worker has held a
  // real `GITHUB_BACKUP_DISPATCH_TOKEN` secret all along, i.e. it is
  // Stage 2 (dispatch-capable), not detection-only. This `vars` entry has
  // now been deployed (version `805f1f0d-b8ee-45d2-bb56-10b3d1382523`,
  // 2026-10-11T16:27:27Z) alongside the rest of this round's fail-closed
  // workflow-selection correction -- resolving to the same
  // `d1-backup-nightly.yml` this Worker already dispatched before, so its
  // existing Stage 2 behavior is unchanged, not newly enabled.
  "vars": { "BACKUP_WORKFLOW_ENVIRONMENT": "staging-independent" },
  // Backup-freshness watchdog (docs/BACKUP-SCHEDULING-RELIABILITY.md) --
  // hourly, deliberately offset from :00 (GitHub's own documented
  // highest-load minute for its `schedule` trigger, and also the minute
  // the main app Worker's own unrelated hourly cron already uses -- see
  // wrangler.staging.jsonc) purely to reduce synchronized load; the
  // watchdog's own logic is rolling-elapsed-time-based (a 26-hour
  // recovery threshold), so the exact minute has no semantic meaning.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
