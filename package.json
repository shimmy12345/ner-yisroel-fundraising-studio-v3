{
  "name": "fundraising-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:production": "node scripts/build-production.mjs",
    "build:staging-independent": "node scripts/build-staging.mjs",
    "deploy:staging-independent": "wrangler deploy --config wrangler.staging.jsonc",
    "start": "vinext start",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:baseline:generate": "node scripts/generate-production-baseline.mjs --write",
    "db:baseline:rehearse": "node scripts/rehearse-production-baseline.mjs",
    "db:production:restore-rehearse": "node scripts/rehearse-production-restore.mjs",
    "db:production:restore-verify-remote": "node scripts/verify-remote-restore.mjs",
    "cleanup:relationship-summary-preview": "node scripts/relationship-summary-cleanup-preview.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.5",
    "gematriya": "^2.0.0",
    "jewish-date": "^2.0.26",
    "jose": "^6.2.8",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/gematriya": "^2.0.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
