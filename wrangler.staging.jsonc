{
  // Independent Cloudflare staging Worker — distinct from legacy ChatGPT
  // Sites staging and from production. Never edit this file to point at
  // production or legacy staging resources.
  "name": "fundraising-os-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // Cloudflare Images (IMAGES binding) is intentionally omitted — it is not
  // required to run the app. worker/index.ts falls back to serving images
  // unoptimized when this binding is absent.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundraising-os-staging-db",
      "database_id": "6c18396c-0a8f-4f2c-ba83-ea809ec10289"
    }
  ],
  // Worker-to-Worker binding only -- NOT an R2 binding. This Worker never
  // gains any R2 credential, binding, or code path to the backup pipeline's
  // storage; it can only call the dedicated status-worker's own fetch
  // handler (status-worker/, deployed and configured separately), which in
  // turn holds the only R2 access -- and only to a status-metadata bucket,
  // never the real backup bucket. See tests/backup-automation.test.mjs's
  // no-R2-binding guardrail for this file, which must never trip.
  "services": [
    {
      "binding": "STATUS_WORKER",
      "service": "fundraising-os-backup-status"
    }
  ],
  "vars": {
    // The Cloudflare Access team domain for the Zero Trust org protecting
    // this Worker.
    "TEAM_DOMAIN": "fundraising-os.cloudflareaccess.com",
    // The AUD tag of the Access Application protecting this Worker's route.
    "POLICY_AUD": "b9796074ba20c3787bd3fc697c0eb0de6981f240081ff3018fb28e5bb95971ed",
    // The sole email allowed to authenticate. Enforced both by the Access
    // policy itself and, independently, by this app's own JWT verification
    // (defense in depth).
    "STAGING_OWNER_EMAIL": "sgoldstein@nirc.edu",
    // Enables Cloudflare Access Service Token auth (e.g. for GET
    // /api/morning-brief from an automated script) -- see cloudflare-
    // env.d.ts's own doc comment. Absent/commented out = service-token
    // auth is not accepted at all, same as before this existed. The
    // Client ID, never the Client Secret, which this Worker never needs
    // to see.
    "MORNING_BRIEF_SERVICE_TOKEN_CLIENT_ID": "983ea5fccaebc48932c5e69df510f74a.access",
    // This Worker's own public URL -- not a secret, just the same
    // *.workers.dev address anyone could look up from the Worker's name.
    // Used to build absolute donor links in the Daily Fundraising Agenda
    // email, whose scheduled handler has no incoming Request to derive an
    // origin from. See cloudflare-env.d.ts for why this lives here rather
    // than as a hardcoded string in application source.
    "APP_BASE_URL": "https://fundraising-os-staging.sgoldstein.workers.dev",
    // AI Meeting Notes "Organize Notes" (docs/AI-HANDOFF.md, "Voice
    // Dictation and AI Meeting Notes") -- the Claude model id, configurable
    // here without a code change. NOT a secret; the API key itself
    // (ANTHROPIC_API_KEY) is a `wrangler secret put` value and deliberately
    // does not exist on this Worker yet -- see this feature's authorization
    // boundary. Until the owner separately approves activating real, paid
    // Anthropic usage, this var has no effect: Organize Notes always
    // reports "unavailable" with no API key present, regardless of model.
    "ANTHROPIC_MODEL": "claude-haiku-5-5"
    // Independent Staging read-only write guard (lib/operations/
    // staging-write-guard.ts, Production Operational Transition round,
    // docs/AI-HANDOFF.md) -- OFF by default (this line stays commented
    // out). Uncomment to "STAGING_WRITES_ENABLED": "true" and redeploy
    // ONLY for a deliberate, time-boxed testing window where a real
    // write through the app is genuinely needed; comment it back out
    // and redeploy immediately afterward. Every mutating /api/**
    // request is blocked here while this stays absent.
    // "STAGING_WRITES_ENABLED": "true"
  },
  // Daily Fundraising Agenda email cron -- EXPLICITLY CLEARED, not merely
  // omitted (2026-10-13 incorrect-morning-email investigation,
  // docs/AI-HANDOFF.md). The 2026-10-12 cutover round deleted this file's
  // "triggers" key entirely, expecting that to deactivate Staging's cron.
  // It did not: Cloudflare does not retroactively clear a Worker's
  // previously-registered Cron Trigger just because a later deploy's
  // config omits the "triggers" key -- removal must be stated explicitly.
  // As a direct result, Staging kept firing its hourly Cron Trigger and
  // kept sending the real "Fundraising Agenda" email every day after the
  // cutover (confirmed live: an email with Staging's own donor links went
  // out again on 2026-10-13T13:02:29Z, a full day after the cutover was
  // believed complete), using Staging's stale pre-fix code and
  // Staging's never-corrected data -- this is what reproduced the
  // "bar mitzvah" recommendation bug the owner reported that day, not a
  // defect in the recommendation engine itself (Production's copy, fixed
  // and data-corrected on 2026-10-12, was unaffected and clean). An empty
  // array is the explicit, verifiable way to clear a Cron Trigger via
  // `wrangler deploy` -- Staging keeps its DB binding, Gmail secrets, and
  // Access protection untouched; only the schedule is turned off.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
